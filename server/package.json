{
  "name": "helmet-proof-server",
  "version": "1.1.0",
  "description": "Evidence server and dashboard for helmet camera proof of delivery",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "create-user": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env tools/create-user.js",
    "simulate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env tools/simulate-helmet.js"
  }
}
