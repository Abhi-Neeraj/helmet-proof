# Every setting here is optional. Copy to .env to change one.
# Accounts, drivers and helmets are managed in the dashboard, not here.

PORT=3000

# Where the database and the videos are kept. On a hosting platform, point
# this at a persistent disk or the videos vanish on every redeploy.
# DATA_DIR=/data

# Videos with no ticket are deleted after this many days.
RETENTION_DAYS=30

# A delivered order with no complete video after this many hours raises an alert.
MISSING_VIDEO_HOURS=6

# Set to 1 when running behind a reverse proxy or a hosting platform.
# TRUST_PROXY=1

# Creates the first admin on a fresh install, for hosts where you cannot run
# "npm run create-user". Ignored once an admin exists. Remove after first start.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Key that signs login cookies. Generated and saved in DATA_DIR when not set.
# SESSION_SECRET=
